<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OrbitalSim.Application/OrbitalSim.Application.csproj" />
    <ProjectReference Include="../OrbitalSim.Infrastructure.Fortran/OrbitalSim.Infrastructure.Fortran.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../build/tdm-gcc/orbitalsim.dll" Link="orbitalsim.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../../build/tdm-gcc/orbitalsim.dll')" />
    <None Include="../../build/cmake/orbitalsim.dll" Link="orbitalsim.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="!Exists('../../build/tdm-gcc/orbitalsim.dll') And Exists('../../build/cmake/orbitalsim.dll')" />
    <None Include="../../build/cmake/liborbitalsim.so" Link="liborbitalsim.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../../build/cmake/liborbitalsim.so')" />
    <None Include="../../build/cmake/liborbitalsim.dylib" Link="liborbitalsim.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../../build/cmake/liborbitalsim.dylib')" />
  </ItemGroup>
</Project>
